# Everything here is optional. By default users bring their own keys in Settings,
# and those keys are sent per request and never stored on the server.

# Lets this deployment's own keys serve anyone who can reach it. Leave this off on a public
# site unless you have added authentication and rate limiting: visitors would spend your money.
# LONGHAND_ALLOW_SERVER_KEYS=true

# Only read when LONGHAND_ALLOW_SERVER_KEYS=true
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
